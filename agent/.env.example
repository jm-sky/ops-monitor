# Static Bearer token — must match the token stored in the ops-monitor sites config.
# Leave empty to disable auth (development only).
AGENT_TOKEN=change-me

# Container listen address and port.
AGENT_HOST=0.0.0.0
AGENT_PORT=9100

# Host loopback port used by Docker. Keep nginx/public access on 9100
# and proxy it to this private port.
AGENT_BIND_PORT=19100

# Timezone of the server clock (IANA name, e.g. Europe/Warsaw). apt's history.log has no
# zone information; leave empty to use the agent process zone. Set it when the agent
# runs in Docker with TZ=UTC but the host clock is local time.
AGENT_APT_LOG_TZ=

# Override the directory holding history.log / history.log.N.gz.
# Default: /host/var/log/apt (Docker bind mount), then /var/log/apt.
AGENT_APT_LOG_DIR=
