# Gear Stack - Caddy Configuration
# This file should be deployed to /etc/caddy/sites-available/gear-stack.caddy
# and symlinked to /etc/caddy/sites-enabled/gear-stack.caddy
#
# Documentation:
# - Header directive: https://caddyserver.com/docs/caddyfile/directives/header
# - Reverse proxy: https://caddyserver.com/docs/caddyfile/directives/reverse_proxy
# - Security headers: https://securityheaders.com
#
# Last updated: 2025-12-24

gear-stack.ovh {
  root * /var/www/gear-stack
  tls jan.madeyski@saasbase.ovh

  # Security Headers
  # Using '>' prefix to ensure headers override any backend headers (defer mode)
  header {
    # Content Security Policy - Google reCaptcha + Sentry + API support
    # References:
    # - https://content-security-policy.com/
    # - https://developers.google.com/recaptcha/docs/faq#im-using-content-security-policy-csp-on-my-website.-how-can-i-configure-it-to-work-with-recaptcha
    # - https://docs.sentry.io/platforms/javascript/install/cdn/#content-security-policy
    >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.gear-stack.ovh https://www.google.com https://*.sentry.io; worker-src 'self' blob:; frame-src 'self' https://www.google.com https://www.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # Prevent clickjacking attacks
    >X-Frame-Options "DENY"

    # Prevent MIME type sniffing
    >X-Content-Type-Options "nosniff"

    # Enable XSS filter for legacy browsers
    >X-XSS-Protection "1; mode=block"

    # HTTP Strict Transport Security (HSTS)
    # Force HTTPS for 1 year, include subdomains, allow preload listing
    >Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Control information sent in Referer header
    >Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy - disable sensitive features
    # Reference: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Permissions-Policy
    >Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Remove server fingerprinting
    -Server
  }

  # Enable compression
  encode gzip zstd

  # Static assets with long-term cache (hashed filenames)
  # Vite hashes all JS/CSS files in /assets/ directory, so they're safe to cache long-term
  # Safe to cache for 1 year because filename changes when content changes
  @hashed_assets {
      # Match all JS and CSS files in /assets/ (Vite hashes all of them)
      path /assets/*.js
      path /assets/*.css
      path /assets/*.woff2
      path /assets/*.woff
      path /assets/*.ttf
      path /assets/*.eot
      path /webfonts/*
  }

  # HTML files should not be cached (or very short cache)
  # This ensures users always get the latest index.html
  @html_files {
      path /*.html
      path /
  }

  # Other static assets (shorter cache)
  # Only matches assets that are NOT hashed (images, favicon, etc.)
  @static_assets {
      path /favicon.ico
      path /robots.txt
      path /*.png
      path /*.jpg
      path /*.jpeg
      path /*.gif
      path /*.svg
      path /*.ico
  }

  # Apply cache headers - order matters, more specific matchers first
  header @hashed_assets {
      Cache-Control "public, max-age=31536000, immutable"
  }

  header @html_files {
      Cache-Control "no-cache, no-store, must-revalidate"
      Pragma "no-cache"
      Expires "0"
  }

  header @static_assets {
      Cache-Control "public, max-age=3600"
  }

  # API routes - proxy to FastAPI backend
  handle /api/* {
      reverse_proxy localhost:8000 {
          # X-Real-IP and X-Forwarded-* headers are added automatically by Caddy
          # No need to set them manually (see Caddy v2.9+ documentation)
      }
  }

  # Serve static files for all other routes
  file_server

  # Fallback to index.html for SPA routing
  try_files {path} /index.html
}

# API subdomain - direct proxy to backend
api.gear-stack.ovh api.gear-stack.dev-made.it {
  reverse_proxy http://localhost:8007
  tls jan.madeyski@gear-stack.ovh
}

# Redirect alternative domain to main domain
gear-stack.dev-made.it {
  redir https://gear-stack.ovh{uri} permanent
}
