# Caddyfile for ops-monitor
# Copy to /etc/caddy/Caddyfile (or import into existing Caddyfile)
# Replace ops-monitor.dev-made.it with your actual domain.
#
# Assumes:
#   - Vue dist is built to /var/www/ops-monitor/dist
#   - FastAPI backend runs at 127.0.0.1:8000 (Docker, localhost-only)

ops-monitor.dev-made.it {
    encode gzip zstd

    # Hashed assets — cache 1 year (Vite adds content hash to filename)
    @hashed_assets {
        path /assets/*.js
        path /assets/*.css
        path /assets/*.woff2
        path /assets/*.woff
        path /assets/*.ttf
    }
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # HTML — never cache (SPA entry point must stay fresh)
    @html {
        path /
        path /*.html
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Other static assets — short cache
    @static {
        path /favicon.ico
        path /robots.txt
        path /*.png
        path /*.svg
        path /*.ico
        path /pwa-*.png
        path /manifest.webmanifest
    }
    header @static Cache-Control "public, max-age=3600"

    # API → FastAPI backend
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Serve built Vue SPA
    root * /var/www/ops-monitor/dist
    file_server
    try_files {path} /index.html
}
